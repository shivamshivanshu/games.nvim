{"comment": "alice challenges bob and carol to ludo; both accept. The first seat to roll is drawn from the seed, so who acts is a placeholder. alice resigns, play goes on for two, then bob resigns and carol wins."}
{"client": "alice", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "alice", "password": "correct horse"}}}
{"client": "alice", "recv": {"id": 1, "type": "ok", "body": {"user": "alice", "heartbeat_ms": 15000}}}
{"client": "bob", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "bob", "password": "correct horse"}}}
{"client": "bob", "recv": {"id": 1, "type": "ok", "body": {"user": "bob", "heartbeat_ms": 15000}}}
{"client": "carol", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "carol", "password": "correct horse"}}}
{"client": "carol", "recv": {"id": 1, "type": "ok", "body": {"user": "carol", "heartbeat_ms": 15000}}}
{"client": "alice", "send": {"id": 2, "type": "challenge.create", "body": {"to": ["bob", "carol"], "game": "ludo", "options": {"time_control": "none"}}}}
{"client": "alice", "recv": {"id": 2, "type": "ok", "body": {"challenge_id": "$challenge"}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": [], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": [], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "carol", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": [], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "send": {"id": 2, "type": "challenge.accept", "body": {"challenge_id": "$challenge"}}}
{"client": "bob", "recv": {"id": 2, "type": "ok", "body": {}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob"], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob"], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "carol", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob"], "game": "ludo", "options": {"time_control": "none"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "carol", "send": {"id": 2, "type": "challenge.accept", "body": {"challenge_id": "$challenge"}}}
{"client": "carol", "recv": {"id": 2, "type": "ok", "body": {}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob", "carol"], "game": "ludo", "options": {"time_control": "none"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
{"client": "bob", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob", "carol"], "game": "ludo", "options": {"time_control": "none"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
{"client": "carol", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob", "carol"], "game": "ludo", "options": {"time_control": "none"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
