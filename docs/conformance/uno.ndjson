{"client": "carol", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": [], "game": "uno", "options": {}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "send": {"id": 2, "type": "challenge.accept", "body": {"challenge_id": "$challenge"}}}
{"client": "bob", "recv": {"id": 2, "type": "ok", "body": {}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob", "carol"], "accepted": ["bob"], "game": "uno", "options": {}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
