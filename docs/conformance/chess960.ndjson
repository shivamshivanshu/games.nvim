{"comment": "alice challenges bob to chess960 as white, bob accepts. The start position is drawn from the game's random seed, so its number, its FEN and the legal moves are placeholders; the number is bound once and must stay the same in every view. Pawns stand on the second and seventh ranks in every start position, so the pawn moves are literal. bob resigns."}
{"client": "alice", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "alice", "password": "correct horse"}}}
{"client": "alice", "recv": {"id": 1, "type": "ok", "body": {"user": "alice", "heartbeat_ms": 15000}}}
{"client": "bob", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "bob", "password": "correct horse"}}}
{"client": "bob", "recv": {"id": 1, "type": "ok", "body": {"user": "bob", "heartbeat_ms": 15000}}}
{"client": "alice", "send": {"id": 2, "type": "challenge.create", "body": {"to": ["bob"], "game": "chess960", "options": {"time_control": "none", "color": "white"}}}}
{"client": "alice", "recv": {"id": 2, "type": "ok", "body": {"challenge_id": "$challenge"}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob"], "accepted": [], "game": "chess960", "options": {"time_control": "none", "color": "white"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob"], "accepted": [], "game": "chess960", "options": {"time_control": "none", "color": "white"}, "state": "pending", "by": null, "game_id": null, "expires_at": "$expires_at"}}}
{"client": "bob", "send": {"id": 2, "type": "challenge.accept", "body": {"challenge_id": "$challenge"}}}
{"client": "bob", "recv": {"id": 2, "type": "ok", "body": {}}}
{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob"], "accepted": ["bob"], "game": "chess960", "options": {"time_control": "none", "color": "white"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
{"client": "bob", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob"], "accepted": ["bob"], "game": "chess960", "options": {"time_control": "none", "color": "white"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
{"client": "alice", "recv": {"type": "game.update", "body": {"game_id": "$game", "game": "chess960", "options": {"time_control": "none", "color": "white"}, "seq": 0, "players": [{"user": "alice", "seat": "white"}, {"user": "bob", "seat": "black"}], "to_act": ["alice"], "result": null, "clock": null, "draw_agreed": [], "controls": ["resign", "offer_draw", "abort"], "events": [], "view": {"fen": "$start_fen", "history_san": [], "last_move": null, "legal_moves": "$legal_0", "claimable_draw": false, "check_square": null, "material": {"white": {"pieces": [], "score": 0}, "black": {"pieces": [], "score": 0}}, "first_ply": 0, "start_position": "$start_position"}, "started_at": "$started_at", "finished_at": null, "summary": null, "digest": null, "exports": null}}}
