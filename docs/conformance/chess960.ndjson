{"comment": "A move in SAN; every view keeps the start position's number."}
{"client": "alice", "send": {"id": 3, "type": "game.act", "body": {"game_id": "$game", "seq": 0, "action": {"kind": "move", "move": "a4"}}}}
{"client": "alice", "recv": {"id": 3, "type": "ok", "body": {"seq": 1}}}
