{"client": "alice", "recv": {"type": "game.update", "body": {"game_id": "$game", "game": "hangman", "options": {}, "seq": 0, "players": [{"user": "alice", "seat": "solver"}], "to_act": ["alice"], "result": null, "clock": null, "draw_agreed": [], "controls": ["resign", "abort"], "events": [], "view": {"pattern": ["", "", "", "", ""], "guessed": [], "missed_words": [], "misses": 0, "remaining": 6}, "started_at": "$started_at", "finished_at": null, "summary": null, "digest": null, "exports": null}}}
