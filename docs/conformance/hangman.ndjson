{"client": "alice", "recv": {"type": "game.update", "body": {"game_id": "$game", "game": "hangman", "options": {}, "seq": 1, "players": [{"user": "alice", "seat": "solver"}], "to_act": ["alice"], "result": null, "clock": null, "draw_agreed": [], "controls": ["resign"], "events": [{"by": "solver", "guess": "aahed", "hit": false, "kind": "guessed"}], "view": {"pattern": ["", "", "", "", ""], "guessed": [], "missed_words": ["aahed"], "misses": 1, "remaining": 5}, "started_at": "$started_at", "finished_at": null, "summary": null, "digest": null, "exports": null}}}
