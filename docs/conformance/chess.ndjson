{"comment": "alice challenges bob to chess as white, bob accepts, they play, bob resigns."}
{"client": "alice", "send": {"id": 1, "type": "auth.login", "body": {"v": 1, "username": "alice", "password": "correct horse"}}}
{"client": "alice", "recv": {"id": 1, "type": "ok", "body": {"user": "alice", "heartbeat_ms": 15000}}}
