{"client": "alice", "recv": {"type": "challenge.changed", "body": {"challenge_id": "$challenge", "from": "alice", "to": ["bob"], "accepted": ["bob"], "game": "chess", "options": {"time_control": "none", "color": "white"}, "state": "accepted", "by": null, "game_id": "$game", "expires_at": "$expires_at"}}}
