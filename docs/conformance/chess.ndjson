{"client": "bob", "recv": {"id": 1, "type": "ok", "body": {"user": "bob", "heartbeat_ms": 15000}}}
{"client": "alice", "send": {"id": 2, "type": "challenge.create", "body": {"to": ["bob"], "game": "chess", "options": {"time_control": "none", "color": "white"}}}}
{"client": "alice", "recv": {"id": 2, "type": "ok", "body": {"challenge_id": "$challenge"}}}
