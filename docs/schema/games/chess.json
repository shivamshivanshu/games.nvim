{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "move"
            },
            "move": {
              "type": "string",
              "pattern": "^\\s*([Oo0]-[Oo0](-[Oo0])?|[KQRBNkqrbn]?[a-hA-H]?[1-8]?[xX]?[a-hA-H][1-8](=?[QRBNqrbn])?)[+#!?]*\\s*$",
              "description": "A move in SAN or UCI, any case, e.g. e4, Nf3, O-O, exd8=Q, e2e4."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "move"
          ],
          "description": "Play a move."
        },
        {
          "properties": {
            "kind": {
              "const": "claim_draw"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "Claim a draw by threefold repetition or the fifty-move rule, on your move."
        }
      ]
    },
    "Material": {
      "properties": {
        "white": {
          "$ref": "#/$defs/SideMaterial"
        },
        "black": {
          "$ref": "#/$defs/SideMaterial"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "white",
        "black"
      ],
      "description": "Material is each side's lead on the board."
    },
    "MoveSquares": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "MovedEvent": {
      "properties": {
        "kind": {
          "const": "moved"
        },
        "by": {
          "type": "string"
        },
        "san": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "san"
      ]
    },
    "PieceLetter": {
      "type": "string",
      "enum": [
        "P",
        "N",
        "B",
        "R",
        "Q",
        "K",
        "p",
        "n",
        "b",
        "r",
        "q",
        "k"
      ],
      "description": "PieceLetter is a piece as FEN writes it: uppercase for white, lowercase for black."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "checkmate",
        "stalemate",
        "insufficient_material",
        "fivefold_repetition",
        "seventy_five_move",
        "threefold_repetition",
        "fifty_move"
      ],
      "description": "The result reasons Chess adds to the core's."
    },
    "SideMaterial": {
      "properties": {
        "pieces": {
          "items": {
            "$ref": "#/$defs/PieceLetter"
          },
          "type": "array"
        },
        "score": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pieces",
        "score"
      ],
      "description": "SideMaterial is one side's material lead: Pieces are the opponent's pieces\nit is up, most valuable first, and Score the points it is ahead, 0 unless\nit is ahead."
    },
    "View": {
      "properties": {
        "fen": {
          "type": "string"
        },
        "history_san": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "last_move": {
          "oneOf": [
            {
              "$ref": "#/$defs/MoveSquares"
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_moves": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claimable_draw": {
          "type": "boolean"
        },
        "check_square": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "$ref": "#/$defs/Material"
        },
        "first_ply": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fen",
        "history_san",
        "last_move",
        "legal_moves",
        "claimable_draw",
        "check_square",
        "material",
        "first_ply"
      ],
      "description": "View.LegalMoves and View.ClaimableDraw are the viewer's own: empty and\nfalse for a seat that is not to move. CheckSquare holds the king of the\nside to move while it is in check. FirstPly is how many plies the start\nposition has behind it, which the move list numbers on from."
    }
  },
  "title": "Chess",
  "description": "The game-specific bodies inside a chess game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "moved": {
      "$ref": "#/$defs/MovedEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
