{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "move"
            },
            "text": {
              "type": "string",
              "pattern": "^\\s*(([1-9]|[12][0-9]|3[0-2])-([1-9]|[12][0-9]|3[0-2])|([1-9]|[12][0-9]|3[0-2])(x([1-9]|[12][0-9]|3[0-2]))+)\\s*$",
              "description": "Squares 1-32, e.g. 11-15, 15x24 or 15x24x31."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "description": "Play one complete move; a capture lists every landing square."
        }
      ],
      "description": "Action is one complete move, such as 11-15 or 15x24x31."
    },
    "Board": {
      "items": {
        "$ref": "#/$defs/Piece"
      },
      "type": "array",
      "maxItems": 32,
      "minItems": 32,
      "description": "Board holds the 32 playable squares; index i is square i+1."
    },
    "MovedEvent": {
      "properties": {
        "kind": {
          "const": "moved"
        },
        "by": {
          "type": "string"
        },
        "move": {
          "type": "string"
        },
        "crowned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "move",
        "crowned"
      ],
      "description": "MovedEvent reports a played move and whether it crowned a man."
    },
    "Piece": {
      "type": "string",
      "enum": [
        "",
        "b",
        "B",
        "w",
        "W"
      ],
      "description": "Piece is what stands on a square; the zero value is an empty square."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "no_pieces",
        "no_moves",
        "forty_move"
      ],
      "description": "The result reasons Checkers adds to the core's."
    },
    "View": {
      "properties": {
        "board": {
          "$ref": "#/$defs/Board"
        },
        "legal": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "last": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "history": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "board",
        "legal",
        "last",
        "history"
      ],
      "description": "View is the position. Legal is the viewer's own: every legal move, each as\nits squares from origin to final landing, and empty unless the viewer is to move."
    }
  },
  "title": "Checkers",
  "description": "The game-specific bodies inside a checkers game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "moved": {
      "$ref": "#/$defs/MovedEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
