{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "roll"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "Roll the dice you do not hold, up to three times a turn."
        },
        {
          "properties": {
            "kind": {
              "const": "hold"
            },
            "die": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5"
              ],
              "description": "The die, 1 to 5."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "die"
          ],
          "description": "Hold a die between rolls, or release it."
        },
        {
          "properties": {
            "kind": {
              "const": "score"
            },
            "box": {
              "type": "string",
              "enum": [
                "ones",
                "twos",
                "threes",
                "fours",
                "fives",
                "sixes",
                "three_of_a_kind",
                "four_of_a_kind",
                "full_house",
                "small_straight",
                "large_straight",
                "yahtzee",
                "chance"
              ],
              "description": "The box to fill."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "box"
          ],
          "description": "Score the dice in an open box, ending your turn."
        }
      ],
      "description": "Action is a roll of the dice not held, a hold toggled on die Die (1 to\nDiceCount), or the dice scored in Box."
    },
    "Box": {
      "type": "string",
      "enum": [
        "ones",
        "twos",
        "threes",
        "fours",
        "fives",
        "sixes",
        "three_of_a_kind",
        "four_of_a_kind",
        "full_house",
        "small_straight",
        "large_straight",
        "yahtzee",
        "chance"
      ],
      "description": "Box is a scorecard box."
    },
    "Card": {
      "properties": {
        "seat": {
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Box"
          },
          "type": "object"
        },
        "upper_total": {
          "type": "integer"
        },
        "upper_bonus": {
          "type": "integer"
        },
        "yahtzee_bonus": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "out": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "seat",
        "scores",
        "upper_total",
        "upper_bonus",
        "yahtzee_bonus",
        "total",
        "out"
      ],
      "description": "Card is one seat's scorecard, in seat order. Scores holds the filled boxes\nalone. Out is a seat that left: its card stays, and it takes no more turns."
    },
    "Option": {
      "properties": {
        "box": {
          "$ref": "#/$defs/Box"
        },
        "score": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "box",
        "score"
      ],
      "description": "Option is a box the seat to act may score, and what it would score there now."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "scorecards_full"
      ],
      "description": "The result reasons Yahtzee adds to the core's."
    },
    "RolledEvent": {
      "properties": {
        "kind": {
          "const": "rolled"
        },
        "by": {
          "type": "string"
        },
        "dice": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "dice"
      ],
      "description": "RolledEvent reports a roll: Dice are all five after it, held ones included."
    },
    "ScoredEvent": {
      "properties": {
        "kind": {
          "const": "scored"
        },
        "by": {
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "score": {
          "type": "integer"
        },
        "yahtzee_bonus": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "box",
        "score",
        "yahtzee_bonus"
      ],
      "description": "ScoredEvent reports a box filled, and the Yahtzee bonus the roll earned on top, 0 or 100."
    },
    "View": {
      "properties": {
        "round": {
          "type": "integer"
        },
        "rounds": {
          "type": "integer"
        },
        "dice": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "held": {
          "items": {
            "type": "boolean"
          },
          "type": "array"
        },
        "rolls_left": {
          "type": "integer"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/Card"
          },
          "type": "array"
        },
        "can_roll": {
          "type": "boolean"
        },
        "can_hold": {
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "type": "array"
        },
        "bonus_at": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "round",
        "rounds",
        "dice",
        "held",
        "rolls_left",
        "cards",
        "can_roll",
        "can_hold",
        "options",
        "bonus_at"
      ],
      "description": "View is the table, the same for every seat but for what the seat to act may do.\n\nRound runs from 1 to Rounds. Dice is empty before the turn's first roll.\nCanRoll, CanHold and Options are the viewer's own: false and empty unless\nit is to act. Options lists the boxes it may score now, with what each\nwould get; under the joker rule that is only the boxes the rule allows.\nBonusAt is the upper total that earns the upper bonus."
    }
  },
  "title": "Yahtzee",
  "description": "The game-specific bodies inside a yahtzee game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "rolled": {
      "$ref": "#/$defs/RolledEvent"
    },
    "scored": {
      "$ref": "#/$defs/ScoredEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
