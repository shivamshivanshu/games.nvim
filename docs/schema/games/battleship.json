{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "place_across"
            },
            "cell": {
              "type": "string",
              "pattern": "^\\s*([a-jA-J])(10|[1-9])\\s*$",
              "description": "Its left end, a1 to j10: the column's letter from a at the left, then the row's number from 1 at the top."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "cell"
          ],
          "description": "Place your next ship lying across, to the right of the cell."
        },
        {
          "properties": {
            "kind": {
              "const": "place_down"
            },
            "cell": {
              "type": "string",
              "pattern": "^\\s*([a-jA-J])(10|[1-9])\\s*$",
              "description": "Its top end, a1 to j10: the column's letter from a at the left, then the row's number from 1 at the top."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "cell"
          ],
          "description": "Place your next ship lying down, below the cell."
        },
        {
          "properties": {
            "kind": {
              "const": "random"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "Place the rest of your fleet at random."
        },
        {
          "properties": {
            "kind": {
              "const": "fire"
            },
            "cell": {
              "type": "string",
              "pattern": "^\\s*([a-jA-J])(10|[1-9])\\s*$",
              "description": "The cell, a1 to j10: the column's letter from a at the left, then the row's number from 1 at the top."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "cell"
          ],
          "description": "Fire at a cell of the opponent's waters you have not fired at."
        }
      ],
      "description": "Action names its cell as text, such as \"c5\": empty for random."
    },
    "Anchors": {
      "properties": {
        "across": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        },
        "down": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "across",
        "down"
      ],
      "description": "Anchors are the squares the viewer's next ship may start on, its left end\nlying across or its top end lying down. Both are empty unless the viewer is placing."
    },
    "Cell": {
      "properties": {
        "row": {
          "type": "integer"
        },
        "col": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "row",
        "col"
      ],
      "description": "Cell is a board position on the wire, 1-based: row 1 is the top, col 1 the left."
    },
    "Phase": {
      "type": "string",
      "enum": [
        "setup",
        "battle",
        "over"
      ],
      "description": "Phase is where the game is: placing fleets, shooting, or finished."
    },
    "ReadyEvent": {
      "properties": {
        "kind": {
          "const": "ready"
        },
        "by": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by"
      ],
      "description": "ReadyEvent reports that By has placed its whole fleet."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "fleet_sunk"
      ],
      "description": "The result reasons Battleship adds to the core's."
    },
    "ShipName": {
      "type": "string",
      "enum": [
        "carrier",
        "battleship",
        "cruiser",
        "submarine",
        "destroyer"
      ],
      "description": "ShipName names a ship of the fleet."
    },
    "ShipSpec": {
      "properties": {
        "name": {
          "$ref": "#/$defs/ShipName"
        },
        "size": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "size"
      ],
      "description": "ShipSpec is a ship of the fleet before it is placed."
    },
    "ShipState": {
      "type": "string",
      "enum": [
        "unplaced",
        "afloat",
        "sunk"
      ],
      "description": "ShipState is how a ship stands: not yet placed, afloat, or sunk. The\nopponent's ships are only ever afloat or sunk to the viewer."
    },
    "ShipStatus": {
      "properties": {
        "name": {
          "$ref": "#/$defs/ShipName"
        },
        "size": {
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ShipState"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "size",
        "state"
      ],
      "description": "ShipStatus is one ship of a fleet as the viewer may know it."
    },
    "ShotEvent": {
      "properties": {
        "by": {
          "type": "string"
        },
        "cell": {
          "$ref": "#/$defs/Cell"
        },
        "outcome": {
          "$ref": "#/$defs/ShotOutcome"
        },
        "ship": {
          "$ref": "#/$defs/ShipName"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "by",
        "cell",
        "outcome"
      ],
      "description": "ShotEvent reports By's shot at Cell of the opponent's waters; Ship names the\nship it sank, and is empty otherwise."
    },
    "ShotEvent_shot": {
      "properties": {
        "kind": {
          "const": "shot"
        },
        "by": {
          "type": "string"
        },
        "cell": {
          "$ref": "#/$defs/Cell"
        },
        "outcome": {
          "$ref": "#/$defs/ShotOutcome"
        },
        "ship": {
          "$ref": "#/$defs/ShipName"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "cell",
        "outcome"
      ],
      "description": "ShotEvent reports By's shot at Cell of the opponent's waters; Ship names the\nship it sank, and is empty otherwise."
    },
    "ShotOutcome": {
      "type": "string",
      "enum": [
        "miss",
        "hit",
        "sunk"
      ],
      "description": "ShotOutcome is what a shot found: water, a ship, or the last afloat square of a ship."
    },
    "Tile": {
      "type": "string",
      "enum": [
        "empty",
        "ship",
        "miss",
        "hit",
        "sunk"
      ],
      "description": "Tile is what one square of a board shows its viewer. On the viewer's own\nboard: water, a ship, or the opponent's miss, hit or sunk ship. On the target\nboard: a square not fired at, or the viewer's miss, hit or sunk ship; once\nthe game is over the opponent's ships that were never hit show as TileShip."
    },
    "View": {
      "properties": {
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "own": {
          "items": {
            "items": {
              "$ref": "#/$defs/Tile"
            },
            "type": "array"
          },
          "type": "array"
        },
        "target": {
          "items": {
            "items": {
              "$ref": "#/$defs/Tile"
            },
            "type": "array"
          },
          "type": "array"
        },
        "fleet": {
          "items": {
            "$ref": "#/$defs/ShipStatus"
          },
          "type": "array"
        },
        "enemy": {
          "items": {
            "$ref": "#/$defs/ShipStatus"
          },
          "type": "array"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/ShipSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "$ref": "#/$defs/Anchors"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        },
        "last": {
          "oneOf": [
            {
              "$ref": "#/$defs/ShotEvent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "phase",
        "own",
        "target",
        "fleet",
        "enemy",
        "next",
        "anchors",
        "targets",
        "last"
      ],
      "description": "View holds both boards as rows from the top: Own is the viewer's waters,\nTarget the opponent's as the viewer's shots found them. Next and Anchors are\nthe viewer's own placement; Targets the squares it may fire at, none unless\nit is to fire. Last is the latest shot of either seat."
    }
  },
  "title": "Battleship",
  "description": "The game-specific bodies inside a battleship game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "ready": {
      "$ref": "#/$defs/ReadyEvent"
    },
    "shot": {
      "$ref": "#/$defs/ShotEvent_shot"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
