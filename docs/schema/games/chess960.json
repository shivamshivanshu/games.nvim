{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "move": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "ActionKind": {
      "type": "string",
      "enum": [
        "move",
        "claim_draw"
      ],
      "description": "ActionKind is the \"kind\" field every action object carries."
    },
    "Material": {
      "properties": {
        "white": {
          "$ref": "#/$defs/SideMaterial"
        },
        "black": {
          "$ref": "#/$defs/SideMaterial"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "white",
        "black"
      ],
      "description": "Material is each side's lead on the board."
    },
    "MoveSquares": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "MovedEvent": {
      "properties": {
        "kind": {
          "const": "moved"
        },
        "by": {
          "type": "string"
        },
        "san": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "san"
      ]
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "checkmate",
        "stalemate",
        "insufficient_material",
        "fivefold_repetition",
        "seventy_five_move",
        "threefold_repetition",
        "fifty_move"
      ],
      "description": "The result reasons Chess960 adds to the core's."
    },
    "SideMaterial": {
      "properties": {
        "pieces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "score": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pieces",
        "score"
      ],
      "description": "SideMaterial is one side's material lead: Pieces are the opponent's pieces\nit is up, most valuable first, and Score the points it is ahead, 0 unless\nit is ahead."
    },
    "View": {
      "properties": {
        "fen": {
          "type": "string"
        },
        "history_san": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "last_move": {
          "oneOf": [
            {
              "$ref": "#/$defs/MoveSquares"
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_moves": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claimable_draw": {
          "type": "boolean"
        },
        "check_square": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "$ref": "#/$defs/Material"
        },
        "first_ply": {
          "type": "integer"
        },
        "start_position": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fen",
        "history_san",
        "last_move",
        "legal_moves",
        "claimable_draw",
        "check_square",
        "material",
        "first_ply",
        "start_position"
      ],
      "description": "View is chess's view, with the start position the game was drawn."
    }
  },
  "title": "Chess960",
  "description": "The game-specific bodies inside a chess960 game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "moved": {
      "$ref": "#/$defs/MovedEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
