{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "turn"
            },
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ],
              "description": "The way to turn."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "direction"
          ],
          "description": "Turn Pac-Man at the first cell where that way is open; resumes a paused game."
        },
        {
          "properties": {
            "kind": {
              "const": "pause"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "Stop the game until the next turn."
        }
      ],
      "description": "Action is a turn, with Direction one of grid.DirectionNames, or a pause, without one."
    },
    "CaughtEvent": {
      "properties": {
        "kind": {
          "const": "caught"
        },
        "by": {
          "type": "string"
        },
        "ghost": {
          "$ref": "#/$defs/GhostName"
        },
        "lives_left": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "ghost",
        "lives_left"
      ],
      "description": "CaughtEvent reports a ghost catching Pac-Man, and the lives left after it."
    },
    "Direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "description": "Direction is one of the four orthogonal ways across a board, named as on the wire."
    },
    "GhostEatenEvent": {
      "properties": {
        "kind": {
          "const": "ghost_eaten"
        },
        "by": {
          "type": "string"
        },
        "ghost": {
          "$ref": "#/$defs/GhostName"
        },
        "points": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "ghost",
        "points"
      ],
      "description": "GhostEatenEvent reports Pac-Man eating a frightened ghost, and the points it scored."
    },
    "GhostMode": {
      "type": "string",
      "enum": [
        "house",
        "scatter",
        "chase",
        "frightened",
        "eyes"
      ],
      "description": "GhostMode is what a ghost is doing."
    },
    "GhostName": {
      "type": "string",
      "enum": [
        "blinky",
        "pinky",
        "inky",
        "clyde"
      ],
      "description": "GhostName names a ghost, and with it how it hunts."
    },
    "GhostView": {
      "properties": {
        "row": {
          "type": "integer"
        },
        "col": {
          "type": "integer"
        },
        "facing": {
          "$ref": "#/$defs/Direction"
        },
        "name": {
          "$ref": "#/$defs/GhostName"
        },
        "mode": {
          "$ref": "#/$defs/GhostMode"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "row",
        "col",
        "facing",
        "name",
        "mode"
      ],
      "description": "GhostView is one ghost."
    },
    "LevelClearedEvent": {
      "properties": {
        "kind": {
          "const": "level_cleared"
        },
        "by": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "level"
      ],
      "description": "LevelClearedEvent reports Pac-Man eating the last dot of a level."
    },
    "PacmanView": {
      "properties": {
        "row": {
          "type": "integer"
        },
        "col": {
          "type": "integer"
        },
        "facing": {
          "$ref": "#/$defs/Direction"
        },
        "next_turn": {
          "oneOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "row",
        "col",
        "facing",
        "next_turn"
      ],
      "description": "PacmanView is Pac-Man, and the turn it will take at the first cell where it can; null for none."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "game_over",
        "cleared"
      ],
      "description": "The result reasons Pac-Man adds to the core's."
    },
    "View": {
      "properties": {
        "maze": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pacman": {
          "$ref": "#/$defs/PacmanView"
        },
        "ghosts": {
          "items": {
            "$ref": "#/$defs/GhostView"
          },
          "type": "array"
        },
        "score": {
          "type": "integer"
        },
        "lives": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "levels": {
          "type": "integer"
        },
        "food_left": {
          "type": "integer"
        },
        "fright_ticks": {
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "can_turn": {
          "type": "boolean"
        },
        "can_pause": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "maze",
        "pacman",
        "ghosts",
        "score",
        "lives",
        "level",
        "levels",
        "food_left",
        "fright_ticks",
        "paused",
        "can_turn",
        "can_pause"
      ],
      "description": "View is the whole game. Maze has one line per row, top first, of one Tile letter per cell. Lives\ncounts the life in play. FrightTicks is how many ticks the ghosts stay frightened. CanTurn and\nCanPause tell the player which actions are open: both are false once the game is over, and\nCanPause is false while paused."
    }
  },
  "title": "Pac-Man",
  "description": "The game-specific bodies inside a pacman game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "caught": {
      "$ref": "#/$defs/CaughtEvent"
    },
    "ghost_eaten": {
      "$ref": "#/$defs/GhostEatenEvent"
    },
    "level_cleared": {
      "$ref": "#/$defs/LevelClearedEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
