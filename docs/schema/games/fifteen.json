{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "slide"
            },
            "tile": {
              "type": "string",
              "pattern": "^\\s*([1-9]|1[0-5])\\s*$",
              "description": "The tile's number, e.g. \"7\"."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "tile"
          ],
          "description": "Slide a tile next to the blank into it."
        },
        {
          "properties": {
            "kind": {
              "const": "move"
            },
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ],
              "description": "The way the tile moves."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "direction"
          ],
          "description": "Slide the tile that moves this way into the blank: up moves the tile below it."
        }
      ],
      "description": "Action is typed input: Tile is the tile's number as text, Direction one of the Directions."
    },
    "Direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "description": "Direction is one of the four orthogonal ways across a board, named as on the wire."
    },
    "Movable": {
      "properties": {
        "tile": {
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tile",
        "direction"
      ],
      "description": "Movable is a tile next to the blank and the way it would move."
    },
    "ResultReason": {
      "type": "string",
      "enum": [
        "solved"
      ],
      "description": "The result reasons 15-puzzle adds to the core's."
    },
    "SlidEvent": {
      "properties": {
        "kind": {
          "const": "slid"
        },
        "by": {
          "type": "string"
        },
        "tile": {
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "by",
        "tile",
        "direction"
      ],
      "description": "SlidEvent reports a tile slid into the blank and the way it moved."
    },
    "View": {
      "properties": {
        "tiles": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "moves": {
          "type": "integer"
        },
        "movable": {
          "items": {
            "$ref": "#/$defs/Movable"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tiles",
        "moves",
        "movable"
      ],
      "description": "View holds Tiles[row][col], rows from the top, with Blank for the empty square. Moves counts\nthe slides so far and is the score. Movable lists the tiles that may slide now, empty once\nthe game is over."
    }
  },
  "title": "15-puzzle",
  "description": "The game-specific bodies inside a fifteen game.update and game.act.",
  "x-action": {
    "$ref": "#/$defs/Action"
  },
  "x-events": {
    "slid": {
      "$ref": "#/$defs/SlidEvent"
    }
  },
  "x-view": {
    "$ref": "#/$defs/View"
  }
}
